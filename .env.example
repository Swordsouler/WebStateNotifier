# Copiez ce fichier en .env et renseignez vos valeurs : docker-compose.yml le lit (env_file).

# Sites surveillés : un bloc par site, numérotés à partir de 0.
# La panne d'un site ne prévient que ses propres destinataires.
Monitors__0__Name=StreamBlades
Monitors__0__Url=https://streamblades.com/health
Monitors__0__Recipients__0=swordsouler.nsl@gmail.com

Monitors__1__Name=Example
Monitors__1__Url=https://example.com
Monitors__1__Recipients__0=admin@example.com
Monitors__1__Recipients__1=ops@example.com
# Facultatif : nombre d'échecs de suite avant l'alerte, pour ce site seulement
# Monitors__1__FailuresBeforeDown=5

# Ancien format à un seul site, toujours accepté (surveillé en plus des Monitors__N)
# Monitor__Name=Mon site
# Monitor__Url=https://example.org
# Monitor__Emails__0=admin@example.org

# Réglages communs à tous les sites, délais en secondes
Monitor__CheckingDownDelaySeconds=60
Monitor__CheckingUpDelaySeconds=30
# Nombre d'échecs de suite avant d'envoyer l'alerte, pour les sites qui ne fixent pas le leur
Monitor__FailuresBeforeDown=3
Monitor__HttpTimeoutSeconds=10
# Fuseau horaire IANA (ex: Europe/Paris, America/New_York, Asia/Tokyo)
Monitor__TimeZoneId=Europe/Paris

# SMTP
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=votre.email@gmail.com
Smtp__Password=votre_mot_de_passe_applicatif
Smtp__FromAddress=votre.email@gmail.com
Smtp__FromName=WebStateNotifier
Smtp__UseSsl=true
