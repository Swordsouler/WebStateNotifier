# Copiez ce fichier en .env et renseignez vos valeurs.
# Puis décommentez la section env_file dans docker-compose.yml.

# URL à surveiller
Monitor__Url=https://example.com

# Emails destinataires (un par ligne avec index .NET)
Monitor__Emails__0=admin@example.com
Monitor__Emails__1=ops@example.com

# Délais en secondes
Monitor__CheckingDownDelaySeconds=60
Monitor__CheckingUpDelaySeconds=30
Monitor__HttpTimeoutSeconds=10

# SMTP
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=votre.email@gmail.com
Smtp__Password=votre_mot_de_passe_applicatif
Smtp__FromAddress=votre.email@gmail.com
Smtp__FromName=WebStateNotifier
Smtp__UseSsl=true
